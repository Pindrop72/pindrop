/* Pindrop scoped styles */
.pindrop-root {
  --bg-1: #070b17;
  --bg-2: #0b1224;
  --panel: rgba(12, 18, 33, 0.72);
  --panel-strong: rgba(19, 27, 48, 0.9);
  --line: rgba(126, 163, 255, 0.2);
  --text: #edf3ff;
  --muted: #a7b9d9;
  --accent: #78d9ff;
  --accent-2: #9b7bff;
  position: relative;
  width: 100%;
  height: 100%;
  display: grid;
  grid-template-columns: minmax(0, 1.65fr) 360px;
  gap: 22px;
  padding: 28px 28px 22px;
  background: radial-gradient(circle at 20% 10%, rgba(106, 132, 255, 0.22), transparent 30%), radial-gradient(circle at 82% 18%, rgba(29, 210, 190, 0.18), transparent 26%), linear-gradient(135deg, var(--bg-1), var(--bg-2));
  color: var(--text);
  overflow: hidden;
}

.pindrop-root::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: linear-gradient(rgba(255,255,255,0.017) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.014) 1px, transparent 1px);
  background-size: 28px 28px;
  mask-image: radial-gradient(circle at center, black 35%, transparent 90%);
  pointer-events: none;
}

.scene-shell {
  position: relative;
  border: 1px solid var(--line);
  border-radius: 28px;
  background: rgba(14, 18, 28, 0.42);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.04), 0 28px 80px rgba(3, 7, 20, 0.72);
  overflow: hidden;
}

.scene-shell::before {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at center, rgba(120, 217, 255, 0.1), transparent 48%);
  pointer-events: none;
}

.scene {
  position: absolute;
  inset: 0;
  perspective: 1200px;
  overflow: hidden;
}

.orbit {
  position: absolute;
  left: 50%;
  top: 52%;
  width: 660px;
  height: 660px;
  transform-style: preserve-3d;
  transform: translate(-50%, -50%) rotateX(62deg) rotateZ(0deg);
  animation: drift 26s linear infinite;
}

@keyframes drift {
  0% { transform: translate(-50%, -50%) rotateX(62deg) rotateZ(0deg); }
  50% { transform: translate(-50%, -50%) rotateX(62deg) rotateZ(180deg); }
  100% { transform: translate(-50%, -50%) rotateX(62deg) rotateZ(360deg); }
}

.ring {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 460px;
  height: 460px;
  transform: translate(-50%, -50%) rotateX(90deg);
  border: 1px solid rgba(129, 149, 255, 0.32);
  border-radius: 50%;
  box-shadow: 0 0 30px rgba(100, 182, 255, 0.12);
}

.ring.r2 {
  width: 580px;
  height: 580px;
  opacity: 0.8;
}

.ring.r3 {
  width: 700px;
  height: 700px;
  opacity: 0.5;
}

.core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 160px;
  height: 160px;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #def8ff 0%, var(--accent) 16%, rgba(110,120,255,0.9) 45%, rgba(8,12,24,0.85) 100%);
  border: 1px solid rgba(255,255,255,0.25);
  box-shadow: 0 0 0 10px rgba(120, 217, 255, 0.07), 0 0 22px rgba(120, 217, 255, 0.6), 0 0 90px rgba(111, 138, 255, 0.38);
  display: grid;
  place-items: center;
  z-index: 10;
}

.core-label {
  font-weight: 800;
  letter-spacing: 0.18em;
  font-size: 12px;
  text-transform: uppercase;
}

.role-card {
  --angle: 0rad;
  --radius: 240px;
  --size: 92px;
  position: absolute;
  left: 50%;
  top: 50%;
  width: var(--size);
  height: var(--size);
  border: 1px solid rgba(255,255,255,0.12);
  background: rgba(9, 16, 31, 0.84);
  border-radius: 22px;
  transform: rotateY(var(--angle)) translateZ(var(--radius)) translate(-50%, -50%);
  box-shadow: 0 0 0 1px rgba(255,255,255,0.03), 0 16px 26px rgba(0,0,0,0.26), 0 0 18px rgba(120, 217, 255, 0.09);
  cursor: pointer;
  color: var(--text);
  transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
  display: grid;
  place-items: center;
  text-align: center;
  padding: 8px 6px;
  z-index: 2;
}

.role-card:hover,
.role-card.active {
  border-color: rgba(120, 217, 255, 0.9);
  box-shadow: 0 0 0 1px rgba(120, 217, 255, 0.4), 0 0 22px rgba(120, 217, 255, 0.32), 0 18px 36px rgba(0,0,0,0.32);
  filter: brightness(1.1);
}

.role-card.active {
  transform: rotateY(var(--angle)) translateZ(calc(var(--radius) + 18px)) translate(-50%, -50%) scale(1.08);
}

.role-dot {
  position: absolute;
  top: 8px;
  left: 8px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 14px var(--accent);
}

.role-name {
  display: block;
  font-weight: 700;
  letter-spacing: 0.04em;
  font-size: 10px;
  line-height: 1.25;
  text-transform: uppercase;
}

.hud {
  position: absolute;
  inset: 18px 22px auto 22px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 20;
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  letter-spacing: 0.24em;
  font-size: 12px;
  text-transform: uppercase;
  opacity: 0.92;
}

.brand-mark {
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  box-shadow: 0 0 18px rgba(120, 217, 255, 0.6);
}

.counter {
  padding: 10px 14px;
  border-radius: 999px;
  background: rgba(12, 17, 30, 0.62);
  border: 1px solid rgba(255,255,255,0.08);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-size: 10px;
  color: var(--muted);
}

.panel {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: 18px;
  border: 1px solid var(--line);
  background: linear-gradient(180deg, rgba(16, 24, 41, 0.9), rgba(10, 15, 27, 0.82));
  border-radius: 26px;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.03), 0 26px 60px rgba(2, 9, 22, 0.56);
}

.panel-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 8px;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

.eyebrow {
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-size: 10px;
  color: var(--muted);
}

.tiny {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 10px;
  border-radius: 999px;
  background: rgba(120, 217, 255, 0.08);
  border: 1px solid rgba(120, 217, 255, 0.18);
  color: var(--text);
  font-size: 10px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.tiny::before {
  content: '';
  display: block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 12px var(--accent);
}

.role-panel {
  display: grid;
  gap: 14px;
}

.role-name-large {
  font-size: clamp(28px, 4.2vw, 42px);
  line-height: 0.96;
  margin: 0;
  letter-spacing: -0.06em;
}

.classline {
  color: var(--muted);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: 11px;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.badge {
  padding: 8px 10px;
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 999px;
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--text);
  background: rgba(255,255,255,0.02);
}

.summary {
  margin: 0;
  color: var(--muted);
  line-height: 1.6;
  font-size: 15px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.stat {
  padding: 14px 12px;
  border-radius: 16px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(255,255,255,0.02);
}

.stat-label {
  display: block;
  color: var(--muted);
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  margin-bottom: 8px;
}

.stat-value {
  font-size: 22px;
  font-weight: 700;
}

.play-btn {
  border: 0;
  border-radius: 16px;
  padding: 16px 18px;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #07111f;
  background: linear-gradient(135deg, var(--accent), #c5f2ff);
  box-shadow: 0 10px 22px rgba(120, 217, 255, 0.32);
  cursor: pointer;
  transition: transform 0.2s ease, filter 0.2s ease;
}

.play-btn:hover {
  transform: translateY(-1px);
  filter: brightness(1.06);
}

.mini-map {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 8px;
  padding-top: 8px;
}

.mini {
  height: 42px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,0.09);
  background: linear-gradient(135deg, rgba(120, 217, 255, 0.05), rgba(155, 123, 255, 0.08));
  position: relative;
  overflow: hidden;
}

.mini::after {
  content: '';
  position: absolute;
  inset: auto 0 0 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--accent), transparent);
}

@media (max-width: 980px) {
  .pindrop-root {
    grid-template-columns: 1fr;
    padding: 18px;
  }

  .panel {
    min-height: 0;
  }
}
